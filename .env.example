# EdgeGuard 配置
# 复制此文件为 .env，填入实际值

# DeepSeek API（必填）
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# LLM 提供商：deepseek / openai / anthropic
LLM_PROVIDER=deepseek

# OpenAI（可选，备用）
OPENAI_API_KEY=

# HuggingFace 镜像（国内网络下载模型更快，留空使用官方源）
HF_ENDPOINT=https://hf-mirror.com

# Embedding 向量化（如本地 sentence-transformers 不可用，使用远程 API 降级）
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# 高德地图 API Key（用于天气/POI 检索，缺失则降级）
AMAP_API_KEY=

# Anthropic（可选，备用）
ANTHROPIC_API_KEY=

# 天气 API Key（OpenWeatherMap，缺失则使用 wttr.in 免费版）
OPENWEATHER_API_KEY=

