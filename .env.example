# EdgeGuard 配置
# 复制此文件为 .env，填入实际值

# ============================================================
# LLM 模型配置（详见 modules/ai/model_factory.py 路由策略）
# ============================================================

# LLM 提供商：deepseek / openai / anthropic
LLM_PROVIDER=deepseek

# --- DeepSeek（必填，推理模型主力）---
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DeepSeek Chat 模型名（默认 deepseek-chat，即 V3）
DEEPSEEK_CHAT_MODEL=deepseek-chat
# DeepSeek Reasoner 模型名（默认 deepseek-reasoner，即 R1）
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# --- 豆包 Lite（可选，快速模型 — 意图识别/交互/安全审计用）---
# 如不配置，快速模型自动降级为 DeepSeek Chat
DOUBAO_API_KEY=
DOUBAO_FAST_MODEL=doubao-lite-128k

# --- OpenAI（可选，备用）---
OPENAI_API_KEY=

# --- Anthropic（可选，备用）---
ANTHROPIC_API_KEY=

# --- 模型参数 ---
MODEL_TIMEOUT=60
MODEL_MAX_RETRIES=2

# ============================================================
# 外部服务
# ============================================================

# HuggingFace 镜像（国内网络下载模型更快，留空使用官方源）
HF_ENDPOINT=https://hf-mirror.com

# Embedding 向量化（如本地 sentence-transformers 不可用，使用远程 API 降级）
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# 高德地图 API Key（用于天气/POI 检索，缺失则降级）
AMAP_API_KEY=

# 天气 API Key（OpenWeatherMap，缺失则使用 wttr.in 免费版）
OPENWEATHER_API_KEY=

# 小红书 Cookie（用于景点数据增强，留空则仅使用高德 POI）
# 获取方式：浏览器登录小红书 → F12 → Network → 复制任意请求的 Cookie
XHS_COOKIE=

